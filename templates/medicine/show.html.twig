{% extends 'base.html.twig' %}

{% block title %}Medicine{% endblock %}

{% block body %}
    <h1>Medicine</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ medicine.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ medicine.name }}</td>
            </tr>
            <tr>
                <th>Format</th>
                <td>{{ medicine.format.value }}</td>
                medicine
            <tr>
                <th>DeletedAt</th>
                <td>{{ medicine.deletedAt ? medicine.deletedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ medicine.createdAt ? medicine.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ medicine.updatedAt ? medicine.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_medicine_index') }}">back to list</a>

    <a href="{{ path('app_medicine_edit', {'id': medicine.id}) }}">edit</a>

    {{ include('medicine/_delete_form.html.twig') }}
{% endblock %}
