{% extends 'base.html.twig' %}

{% block title %}Medicine index{% endblock %}

{% block body %}
    <h1>Medicine index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Format</th>
                <th>DeletedAt</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for medicine in medicines %}
            <tr>
                <td>{{ medicine.id }}</td>
                <td>{{ medicine.name }}</td>
                <td>{{ medicine.format.value }}</td>
                <td>{{ medicine.deletedAt ? medicine.deletedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ medicine.createdAt ? medicine.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ medicine.updatedAt ? medicine.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_medicine_show', {'id': medicine.id}) }}">show</a>
                    <a href="{{ path('app_medicine_edit', {'id': medicine.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_medicine_new') }}">Create new</a>
{% endblock %}
