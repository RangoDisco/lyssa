{% extends 'base.html.twig' %}

{% block title %}Dispense{% endblock %}

{% block body %}
    <h1>Dispense</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ dispense.id }}</td>
            </tr>
            <tr>
                <th>ScheduledAt</th>
                <td>{{ dispense.scheduledAt ? dispense.scheduledAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DoneAt</th>
                <td>{{ dispense.doneAt ? dispense.doneAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DeletedAt</th>
                <td>{{ dispense.deletedAt ? dispense.deletedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ dispense.createdAt ? dispense.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ dispense.updatedAt ? dispense.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_dispense_index') }}">back to list</a>

    <a href="{{ path('app_dispense_edit', {'id': dispense.id}) }}">edit</a>

    {{ include('dispense/_delete_form.html.twig') }}
{% endblock %}
