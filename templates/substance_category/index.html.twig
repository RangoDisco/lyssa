{% extends 'base.html.twig' %}

{% block title %}SubstanceCategory index{% endblock %}

{% block body %}
    <h1>SubstanceCategory index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Color</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for substance_category in substance_categories %}
            <tr>
                <td>{{ substance_category.id }}</td>
                <td>{{ substance_category.color }}</td>
                <td>{{ substance_category.name }}</td>
                <td>
                    <a href="{{ path('app_substance_category_show', {'id': substance_category.id}) }}">show</a>
                    <a href="{{ path('app_substance_category_edit', {'id': substance_category.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_substance_category_new') }}">Create new</a>
{% endblock %}
