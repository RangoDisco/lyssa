{% extends 'base.html.twig' %}

{% block title %}Invitation index{% endblock %}

{% block body %}
    <h1>Invitation index</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Email</th>
            <th>AccessLevel</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for invitation in invitations %}
            <tr>
                <td>{{ invitation.email }}</td>
                <td>{{ invitation.accessLevel.value }}</td>
                <td>
                    <a href="{{ path('app_invitation_show', {'id': invitation.id}) }}">show</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <twig:Paginator :result="invitations"/>

    <a href="{{ path('app_invitation_new') }}">Create new</a>
{% endblock %}
