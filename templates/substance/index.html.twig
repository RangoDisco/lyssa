{% extends 'base.html.twig' %}

{% block title %}substance index{% endblock %}

{% block body %}
    <h1>substance index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Source</th>
                <th>DeletedAt</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for substance in substances %}
            <tr>
                <td>{{ substance.id }}</td>
                <td>{{ substance.name }}</td>
                <td>{{ substance.code }}</td>
                <td>{{ substance.deletedAt ? substance.deletedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ substance.createdAt ? substance.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ substance.updatedAt ? substance.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_substance_show', {'id': substance.id}) }}">show</a>
                    <a href="{{ path('app_substance_edit', {'id': substance.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_substance_new') }}">Create new</a>
{% endblock %}
