{% extends 'base.html.twig' %}

{% block title %}Lab index{% endblock %}

{% block body %}
    <h1>Lab index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>DeletedAt</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lab in labs %}
            <tr>
                <td>{{ lab.id }}</td>
                <td>{{ lab.name }}</td>
                <td>{{ lab.deletedAt ? lab.deletedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ lab.createdAt ? lab.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ lab.updatedAt ? lab.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_lab_show', {'id': lab.id}) }}">show</a>
                    <a href="{{ path('app_lab_edit', {'id': lab.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_lab_new') }}">Create new</a>
{% endblock %}
