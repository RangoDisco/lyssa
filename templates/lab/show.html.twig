{% extends 'base.html.twig' %}

{% block title %}Lab{% endblock %}

{% block body %}
    <h1>Lab</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ lab.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ lab.name }}</td>
            </tr>
            <tr>
                <th>DeletedAt</th>
                <td>{{ lab.deletedAt ? lab.deletedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ lab.createdAt ? lab.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ lab.updatedAt ? lab.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_lab_index') }}">back to list</a>

    <a href="{{ path('app_lab_edit', {'id': lab.id}) }}">edit</a>

    {{ include('lab/_delete_form.html.twig') }}
{% endblock %}
