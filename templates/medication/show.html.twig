{% extends 'base.html.twig' %}

{% block title %}Medication{% endblock %}

{% block body %}
    <div class="flex flex-col gap-8 items-center w-full md:max-w-xl md:mx-auto">
        <div class="flex flex-col items-center">
            <img
                class="rounded-lg object-cover h-24 w-24 border"
                src="{{ medication.picture is not null
                ? asset('uploads/' ~ medication.picture.imageName)
                : asset('uploads/Loulou-6a510b7e420d12.88227757.jpg') }}"
                onerror="this.src='{{ asset('uploads/Loulou-6a510b7e420d12.88227757.jpg') }}'"
                alt="{{ medication.name }}"
            />

            <twig:Typography:H3>{{ medication.name }}</twig:Typography:H3>
            {% if type != null %}
                <p
                    class="text-muted-foreground font-normal text-md">{{ type.name }}</p>
            {% endif %}
        </div>

        <twig:MedicationDispenseList :medication="medication"/>
        <twig:MedicationVariantList :medication="medication"/>

        <a href="{{ path('app_medication_index') }}">back to list</a>

        <a href="{{ path('app_medication_edit', {'id': medication.id}) }}">edit</a>

        {{ include('medication/_delete_form.html.twig') }}
    </div>
{% endblock %}
