<div class="flex flex-col gap-4 w-full" {{ attributes }}>
    <div class="flex items-center justify-between ">
        <twig:Typography:H3>Medicine</twig:Typography:H3>
        {% if this.medicineSubstances.next < this.medicineSubstances.results|length %}
            <a class="text-sm text-muted-foreground"
               href="{{ path('app_medicine_index', {substance: substance.id}) }}">See all</a>
        {% endif %}
    </div>

    <div class="flex flex-col gap-2">
        {% for medicineSubstance in this.medicineSubstances.results %}
            <twig:SubstanceMedicineListItem :medicineSubstance="medicineSubstance"/>
        {% endfor %}
    </div>
</div>
