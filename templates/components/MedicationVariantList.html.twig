<div class="flex flex-col gap-4 w-full" {{ attributes }}>
    <div class="flex items-center justify-between ">
        <twig:Typography:H3>Variants</twig:Typography:H3>
        {% if this.variants.next < this.variants.results|length %}
            <a class="text-sm text-muted-foreground"
               href="{{ path('app_variant_index', {medication: medication.id}) }}">See all</a>
        {% endif %}
    </div>

    <div class="flex flex-col gap-2">
        {% for variant in this.variants.results %}
            <twig:MedicationVariantListItem :variant="variant"/>
        {% endfor %}
    </div>
</div>
